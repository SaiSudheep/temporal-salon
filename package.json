{
  "name": "temporal-assessment-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Student starter for the Temporal post-assessment.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx src/api.ts",
    "dev:worker": "tsx src/worker.ts",
    "start:temporal": "docker compose up -d temporal",
    "stop": "docker compose down",
    "test": "tsx --test tests/salon.test.ts tests/workflow.test.ts",
    "test:ui": "playwright test",
    "format": "prettier --write src public tests scripts playwright.config.ts README.md evidence/README.md",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@temporalio/testing": "1.24.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "prettier": "^3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
